# New experiment result directories are ignored by default.
/experiments/*/*/

# Native Nsight reports stay local; the dashboard reads SQLite/CSV/JSON.
*.nsys-rep
*.nsys-rep.gz
*.ncu-rep
*.ncu-rep.gz
*.safetensors
*.gguf
*.pt
*.pth
